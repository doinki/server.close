{
  "name": "server.close",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "release": "pnpm run build && publint && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.18.10",
    "prettier": "^3.6.2",
    "publint": "^0.3.14",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "author": {
    "email": "doinki94@gmail.com",
    "name": "doinki",
    "url": "https://github.com/doinki"
  },
  "bugs": "https://github.com/doinki/server.close/issues",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/doinki/server.close#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinki/server.close.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
